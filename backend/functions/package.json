{
  "name": "multiplatform-pos-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.cjs",
    "test": "npm run build && node ../../scripts/run-node-tests.cjs test",
    "mpesa:lifecycle": "node scripts/mpesa-lifecycle.cjs",
    "mpesa:configure": "node scripts/configure-mpesa.cjs",
    "watch": "tsc -p tsconfig.json --watch",
    "e2e": "cd ../.. && node scripts/run-emulator-checks.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

