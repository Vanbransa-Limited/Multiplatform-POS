{
  "name": "vanbransa-pos-workspace",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": "22.x" },
  "comment": "Task runner only. frontend and backend/functions are independent deployables and own their dependencies; they share none, so there is nothing to hoist.",
  "scripts": {
    "setup": "npm --prefix frontend install && npm --prefix backend/functions install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm run test:tooling && npm --prefix frontend test && npm --prefix backend/functions test",
    "test:tooling": "node scripts/run-node-tests.cjs scripts/test",
    "verify:baseline": "node scripts/verify-baseline.cjs",
    "test:emulator": "node scripts/run-emulator-checks.cjs",
    "test:receipts": "node scripts/run-emulator-checks.cjs --receipts-only",
    "test:etims": "node scripts/run-emulator-checks.cjs --etims-only",
    "test:tables": "node scripts/run-emulator-checks.cjs --tables-only",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend/functions test",
    "smoke": "node scripts/smoke-test.mjs",
    "emulators": "node scripts/start-emulators.cjs",
    "emulators:doctor": "node scripts/start-emulators.cjs --doctor",
    "test:emulator-runner": "node --test scripts/test/emulator-runner.test.cjs",
    "deploy": "npm run build && node scripts/safe-deploy.cjs"
  }
}
