rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasTenantClaim(tenantId) {
      return signedIn()
        && request.auth.token.tenant_id is string
        && request.auth.token.tenant_id == tenantId;
    }

    function canReadTenantDocument() {
      return resource.data.tenantId is string
        && hasTenantClaim(resource.data.tenantId);
    }

    function managesTenant() {
      return signedIn()
        && request.auth.token.staff_role is string
        && request.auth.token.staff_role in ['owner', 'manager'];
    }

    // Modules the sidebar hides from most roles. Hiding a button is not access
    // control, so the same restriction is enforced on the data itself.
    function readsFinancials() {
      return managesTenant() && canReadTenantDocument();
    }

    function validSettingsUpdate(tenantId) {
      return resource.data.tenantId == tenantId
        && request.resource.data.tenantId == tenantId
        && hasTenantClaim(tenantId)
        && managesTenant()
        && request.auth.token.staff_id is string
        && request.resource.data.updatedByStaffId == request.auth.token.staff_id
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'establishmentName',
          'receiptFooter',
          'locale',
          'timezone',
          'cashEnabled',
          'lowStockThresholdQty',
          'acceptedPaymentMethods',
          // When the trading day rolls over, and where the night session
          // begins. These decide which day money is booked to, so they are
          // writable only by the same roles that own the rest of settings.
          'dayStartHour',
          'nightStartHour',
          'updatedAt',
          'updatedByStaffId'
        ])
        // Each field is checked only when the document actually carries it.
        // Asserting on all of them unconditionally meant a settings document
        // written without a receipt footer, locale or timezone could never be
        // updated again - the owner ticked a payment method, the rule refused
        // the whole write, and nothing on the screen could explain why.
        && (!('establishmentName' in request.resource.data) || (
          request.resource.data.establishmentName is string
          && request.resource.data.establishmentName.size() > 0
          && request.resource.data.establishmentName.size() <= 120
        ))
        && (!('receiptFooter' in request.resource.data) || (
          request.resource.data.receiptFooter is string
          && request.resource.data.receiptFooter.size() <= 500
        ))
        && (!('locale' in request.resource.data) || request.resource.data.locale is string)
        && (!('timezone' in request.resource.data) || request.resource.data.timezone is string)
        && (!('cashEnabled' in request.resource.data) || request.resource.data.cashEnabled is bool)
        && (!('lowStockThresholdQty' in request.resource.data) || (
          request.resource.data.lowStockThresholdQty is int
          && request.resource.data.lowStockThresholdQty >= 0
        ))
        && request.resource.data.acceptedPaymentMethods is list
        && request.resource.data.acceptedPaymentMethods.size() > 0
        // 'credit' is a stored value, not a tender anyone chooses: a proforma
        // books to it. Leaving it out of this list meant any business whose
        // settings already carried it was frozen out of its own settings
        // screen for good, because hasOnly checks the whole resulting list.
        && request.resource.data.acceptedPaymentMethods.hasOnly([
          'cash', 'mpesa', 'card', 'airtel_money', 'bank_transfer', 'credit'
        ])
        // Validated only when present, so a business that has never set its
        // trading hours can still save every other setting. The night must
        // begin after the day, or a session would be empty or inverted.
        && (!('dayStartHour' in request.resource.data) || (
          request.resource.data.dayStartHour is int
          && request.resource.data.dayStartHour >= 0
          && request.resource.data.dayStartHour <= 23
        ))
        && (!('nightStartHour' in request.resource.data) || (
          request.resource.data.nightStartHour is int
          && request.resource.data.nightStartHour >= 0
          && request.resource.data.nightStartHour <= 23
        ))
        && (
          !('dayStartHour' in request.resource.data)
          || !('nightStartHour' in request.resource.data)
          || request.resource.data.nightStartHour > request.resource.data.dayStartHour
        );
    }

    // Tenant creation and claim assignment are Admin-only operations.
    match /tenants/{tenantId} {
      allow read: if hasTenantClaim(tenantId);
      allow write: if false;
    }

    // Browser reads are tenant-scoped. Queries must include tenantId because
    // Firestore security rules are not result filters.
    match /branches/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /devices/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // Staff profiles carry names, emails and roles for the whole business.
    // Only administrators need the roster; identities are written exclusively
    // by createStaffUser and setStaffActive.
    match /staff/{documentId} {
      allow read: if readsFinancials()
        || (canReadTenantDocument() && resource.data.id == request.auth.token.staff_id);
      allow write: if false;
    }

    match /categories/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /products/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /barcodes/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /customers/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /suppliers/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /stock_balances/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /sales/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // Issued proformas are immutable; only server callables may issue or settle them.
    match /proformas/{documentId} {
      allow read: if canReadTenantDocument()
        && request.auth.token.staff_role in ['owner', 'manager', 'store_manager', 'supervisor', 'bar_staff', 'cashier', 'store_keeper'];
      allow write: if false;
    }

    match /customer_orders/{documentId} {
      allow read: if canReadTenantDocument()
        && request.auth.token.staff_role in ['owner', 'manager', 'store_manager', 'supervisor', 'bar_staff', 'cashier', 'store_keeper'];
      allow write: if false;
    }

    match /sale_lines/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // Open tabs, published by each till so the business can be watched while it
    // is running. Readable by everyone who works here - an owner needs the whole
    // floor, and a cashier taking over a table needs to see it. Server-written
    // only: this is a mirror of what a till holds, never a source of money.
    match /open_orders/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    match /payments/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // The till watches its own pending push for the STK result. Writes stay
    // server-only: this document is what says a customer has actually paid.
    match /mpesa_payments/{documentId} {
      allow read: if canReadTenantDocument()
        && request.auth.token.staff_id is string
        && (
          resource.data.staffId == request.auth.token.staff_id
          || managesTenant()
        );
      allow write: if false;
    }

    match /shifts/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // A tablet cannot reach the counter's USB printer, so it queues the receipt
    // here and the station prints it. These carry no money decision: a job is a
    // copy of a receipt, and printing one settles nothing.
    match /print_jobs/{documentId} {
      allow read: if canReadTenantDocument();
      allow create: if hasTenantClaim(request.resource.data.tenantId)
        && request.auth.token.staff_id is string
        && request.resource.data.id == documentId
        && request.resource.data.status == 'queued'
        && !request.resource.data.keys().hasAny(['checkoutReceipt'])
        && request.resource.data.createdByStaffId == request.auth.token.staff_id
        && request.resource.data.createdAt == request.time
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.receipt is map
        && request.resource.data.widthClass in ['receipt-paper-58', 'receipt-paper-80'];
      // The only permitted change is one station claiming a waiting job, so a
      // printed receipt can never be edited or re-queued from a browser.
      allow update: if canReadTenantDocument()
        && !resource.data.keys().hasAny(['checkoutReceipt'])
        && resource.data.status == 'queued'
        && request.resource.data.status == 'printed'
        && request.resource.data.printedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'printedAt',
          'printedByDeviceId'
        ]);
      allow delete: if false;
    }

    // Presence only, so the till can tell a cashier whether paper will actually
    // come out before it promises that it will.
    match /print_stations/{deviceId} {
      allow read: if canReadTenantDocument();
      allow create, update: if hasTenantClaim(request.resource.data.tenantId)
        && request.resource.data.deviceId == deviceId
        && request.resource.data.branchId is string
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    match /stock_movements/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // House requests waiting on the store manager. Created and decided only by
    // changeStock / decideStockRequest, so nobody can approve their own by hand.
    match /stock_requests/{documentId} {
      allow read: if canReadTenantDocument();
      allow write: if false;
    }

    // Audit logs record who did what across the whole business, and the
    // sidebar already restricts them to owners and managers.
    match /audit_logs/{documentId} {
      allow read: if readsFinancials();
      allow write: if false;
    }

    match /tenant_settings/{tenantId} {
      allow read: if hasTenantClaim(tenantId);
      allow update: if validSettingsUpdate(tenantId);
      allow create, delete: if false;
    }

    // PIN hashes, throttling state, verified payment intents, counters, and all
    // unknown documents are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
